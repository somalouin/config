{
    "tab_size": 4,
    "global_lsp_settings": {
        "button": false,
    },
    "terminal": {
        "font_family": ".ZedMono",
        "dock": "bottom",
    },
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": {
                        "enabled": "never",
                    },
                },
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "never",
                    },
                },
            },
            "enable_lsp_tasks": true,
        },
    },
    "agent_servers": {
        "cursor": {
            "default_config_options": {
                "model": "grok-4.6"
            },
            "type": "registry",
        },
    },
    "outline_panel": {
        "button": false,
        "dock": "left",
    },
    "collaboration_panel": {
        "button": false,
        "dock": "left",
    },
    "agent": {
        "sidebar_side": "right",
        "flexible": true,
        "button": true,
        "play_sound_when_agent_done": "when_hidden",
        "dock": "left",
        "favorite_models": [],
        "model_parameters": [],
    },
    "git_panel": {
        "dock": "right",
    },
    "diff_view_style": "unified",
    "ui_font_size": 15.0,
    "buffer_font_size": 12.0,
    "buffer_font_family": ".ZedMono",
    "icon_theme": {
        "mode": "light",
        "light": "Zed (Default)",
        "dark": "Zed (Default)",
    },
    "theme": {
        "mode": "system",
        "light": "One Dark",
        "dark": "One Dark",
    },
    "project_panel": {
        "dock": "right",
        "indent_size": 12,
    },
}
